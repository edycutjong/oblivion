# frontier-encrypt-ika Environment Variables
# Copy to .env.local and fill in values

# Encrypt SDK Configuration (REFHE)
# Note: Encrypt SDK is currently in pre-alpha. For this hackathon project,
# we use a fallback mock so no real API key is required. You can use any dummy value.
NEXT_PUBLIC_ENCRYPT_API_URL=https://api.encrypt.xyz/v1/devnet
ENCRYPT_API_KEY=dummy_key_for_local_dev

# Ika SDK Configuration (MPC)
# Note: Ika SDK is also in pre-alpha. For this hackathon project,
# we use a fallback mock so no real Project ID is required. You can use any dummy value.
NEXT_PUBLIC_IKA_NETWORK_URL=https://network.ika.xyz/devnet
IKA_PROJECT_ID=dummy_project_id_for_local_dev
